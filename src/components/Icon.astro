---
/* Знаковая система бренда (FacetMark из ds-bundle): геометрия преломления
   на сетке 24×24 волосяной линией. Статичный SVG — без JS. */
interface Props {
  name: string;
  size?: number;
  tone?: 'gold' | 'ink' | 'current' | 'light';
  strokeWidth?: number;
  class?: string;
}
const { name, size = 22, tone = 'gold', strokeWidth = 1, class: cls } = Astro.props;

const G: Record<string, string> = {
  grain: '<path d="M12 2.5 L20 8.5 L17 20.5 L7 20.5 L4 8.5 Z"/><path d="M12 2.5 V20.5"/><path d="M4 8.5 H20"/>',
  ray: '<path d="M11.5 4.5 V19.5"/><path d="M2 7.5 L11.5 12"/><path d="M11.5 12 L22 8.5"/><path d="M11.5 12 L22 12.5"/><path d="M11.5 12 L22 16.5"/>',
  arrow: '<path d="M3.5 12 H19.5"/><path d="M14 6.5 L19.5 12 L14 17.5"/>',
  arrowUp: '<path d="M6.5 17.5 L17.5 6.5"/><path d="M9 6.5 H17.5 V15"/>',
  plus: '<path d="M12 4.5 V19.5"/><path d="M4.5 12 H19.5"/>',
  minus: '<path d="M4.5 12 H19.5"/>',
  close: '<path d="M5.5 5.5 L18.5 18.5"/><path d="M18.5 5.5 L5.5 18.5"/>',
  menu: '<path d="M3.5 8 H20.5"/><path d="M3.5 12 H20.5"/><path d="M3.5 16 H14"/>',
  play: '<path d="M9 5.5 L19 12 L9 18.5 Z"/>',
  checkRing: '<circle cx="12" cy="12" r="9"/><path d="M8 12.2 L11 15.2 L16.2 9"/>',
};

const stroke =
  tone === 'ink' ? 'var(--ink-900)'
  : tone === 'current' ? 'currentColor'
  : tone === 'light' ? 'var(--paper-1)'
  : 'var(--gold-deep)';
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" role="presentation" aria-hidden="true" class={'fm' + (cls ? ' ' + cls : '')}>
  <g stroke={stroke} stroke-width={strokeWidth} stroke-linecap="butt" stroke-linejoin="miter" vector-effect="non-scaling-stroke" set:html={G[name] || G.grain} />
</svg>
